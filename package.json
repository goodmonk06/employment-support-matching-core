{
  "name": "employment-support-matching-core",
  "version": "1.0.0",
  "description": "就労支援A/B型向けの利用者スキルとタスクのマッチングエンジン",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "example": "tsx examples/basic-matching.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:enhanced": "tsx scripts/seed-enhanced.ts"
  },
  "keywords": [
    "matching",
    "employment-support",
    "task-matching",
    "skill-matching"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.26.0",
    "@fastify/cors": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.0",
    "tsx": "^4.7.1",
    "typescript": "^5.0.0",
    "vitest": "^1.2.2"
  }
}
